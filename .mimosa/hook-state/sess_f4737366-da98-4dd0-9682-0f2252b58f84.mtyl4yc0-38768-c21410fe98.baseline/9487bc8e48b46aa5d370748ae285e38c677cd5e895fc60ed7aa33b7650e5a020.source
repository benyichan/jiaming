package com.xiaojiaoyin.jiaming

import android.app.Application
import com.xiaojiaoyin.jiaming.data.AssetsDataSource
import com.xiaojiaoyin.jiaming.data.db.AppDatabase
import com.xiaojiaoyin.jiaming.ui.MainViewModel

/** AppGraph 手工依赖注入（小脚印系标准路径，不用 Hilt） */
class JiamingApp : Application() {
    lateinit var graph: AppGraph
        private set

    override fun onCreate() {
        super.onCreate()
        graph = AppGraph(this)
    }
}

class AppGraph(app: Application) {
    val assets: AssetsDataSource = AssetsDataSource(app)
    val db: AppDatabase = AppDatabase.build(app)
    val mainViewModel: MainViewModel = MainViewModel(assets, db)
}
